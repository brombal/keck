{
  "name": "keck",
  "version": "2.3.5",
  "description": "Simple observable state ✨🔭 for React and vanilla JS",
  "author": "Alex Brombal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brombal/keck.git"
  },
  "scripts": {
    "build": "rm -f index.* react.* && rollup -c",
    "test": "tsc && npm run lint && vitest run --coverage",
    "lint": "biome check --write ./src ./test",
    "prepare": "husky"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./react.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lodash.clonedeep": "^4.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "terser": "^5.46.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
